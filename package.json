{
  "name": "phonics-planet",
  "version": "0.1.0",
  "private": true,
  "description": "拼读星球开发骨架",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:data": "node scripts/build-data.cjs",
    "validate:data": "node scripts/validate-data.cjs",
    "test": "node --test tests/*.test.cjs",
    "check:templates": "node scripts/check-templates.cjs",
    "content:status": "node scripts/content-status.cjs",
    "resources:verify": "node scripts/verify-resources.cjs",
    "resources:bundle": "node scripts/build-audio-bundle.cjs",
    "preview": "node scripts/preview.cjs",
    "check": "npm run validate:data && npm run build:data && npm test && node scripts/check-project.cjs && npm run check:templates"
  },
  "devDependencies": {
    "miniprogram-compiler": "0.2.3"
  }
}
