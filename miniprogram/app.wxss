page { background:#F7F6EF;color:#193C3A;font-family:system-ui,-apple-system,sans-serif;font-size:32rpx; } .page { padding:32rpx; } .eyebrow {font-size:24rpx;letter-spacing:4rpx;color:#16776F;} .title {font-size:52rpx;font-weight:700;margin:16rpx 0 24rpx;} .subtitle {font-size:30rpx;color:#54716D;line-height:1.7;} .card {background:#fff;border:2rpx solid #E5EAE2;border-radius:28rpx;padding:28rpx;margin:20rpx 0;overflow-wrap:anywhere;} .card-title {font-size:36rpx;font-weight:650;margin-bottom:12rpx;} .grid {display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx;} .grid .card {margin:0;} .ipa {font-family:'Arial','Helvetica',sans-serif;font-size:60rpx;} .muted {color:#54716D;font-size:28rpx;line-height:1.6;} button {margin:20rpx 0;background:#16776F;color:white;border-radius:24rpx;font-size:32rpx;} button::after {border:0;} button.secondary {background:#DDF0E9;color:#193C3A;} navigator {color:inherit;} .empty {padding:60rpx 20rpx;text-align:center;} .section {font-size:36rpx;font-weight:650;margin:32rpx 0 20rpx;} .tag {font-size:26rpx;color:#16776F;}
