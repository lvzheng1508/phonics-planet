.audio-button__control{background:#16776f;color:#fff;border-radius:22rpx;font-size:30rpx;min-height:88rpx;margin:20rpx 0 8rpx}.audio-button__control::after{border:0}.audio-button__control.disabled{background:#e7eae4;color:#62736b}.active{background:#193c3a}.hint{color:#64796f;font-size:25rpx;text-align:center;padding:8rpx}.compact .audio-button__control{font-size:26rpx;margin:12rpx 0 0;min-width:96rpx}.compact .hint{display:none}
.audio-button__control.downloading{background:#d7eee7;color:#16776f;animation:audio-pulse 1.3s ease-in-out infinite}@keyframes audio-pulse{0%,100%{opacity:1}50%{opacity:.65}}
