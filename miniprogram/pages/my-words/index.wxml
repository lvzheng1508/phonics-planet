<view class="page"><view class="eyebrow">YOUR WORD COLLECTION</view><view class="row"><view class="title">我的单词</view><button class="small-button" bindtap="showAdd">{{adding ? '收起' : '＋ 添加'}}</button></view><view class="subtitle">把好奇的声音，一点点收集起来。</view><view wx:if="{{adding}}" class="card"><view class="card-title">遇到了一个新词？</view><input class="search" placeholder="英文单词或短语" value="{{newWord}}" bindinput="inputWord" maxlength="80"/><input class="search" placeholder="写下它的意思" value="{{newMeaning}}" bindinput="inputMeaning" maxlength="120"/><view wx:if="{{error}}" class="error">{{error}}</view><button bindtap="saveWord">加入我的单词</button><view class="muted">新词可以先用词卡复习，发音讲解需准备后加入。</view></view><input class="search" placeholder="在收藏里搜索" value="{{query}}" bindinput="search" maxlength="80"/><navigator wx:if="{{words.length}}" url="/pages/review/index" class="primary-link">复习收藏词卡 →</navigator><navigator wx:for="{{words}}" wx:key="id" url="{{item.url}}" class="word-row"><view><view class="word-name">{{item.word}}</view><view class="muted">{{item.meanings[0]}}</view></view><text>↗</text></navigator><view wx:if="{{!words.length}}" class="empty"><view class="empty-star">☆</view><view>{{query ? '换个关键词再找找吧。' : '你的单词星球，等你来点亮。'}}</view><navigator url="/pages/curriculum/index" class="primary-link">去课本里找一个词</navigator></view></view>
