<view wx:if="{{unit}}" class="page"><view class="eyebrow">WORD EXPLORER · {{count}} WORDS</view><view class="title">{{unit.name}}</view><input class="search" placeholder="搜索英文或中文释义" value="{{query}}" bindinput="search" maxlength="80"/><navigator wx:for="{{entries}}" wx:key="id" url="{{item.url}}" class="word-row"><view><view class="word-name">{{item.word}}</view><view class="muted">{{item.contextMeaning}}</view></view><text>↗</text></navigator><view wx:if="{{!entries.length}}" class="empty">没有找到这个词，换个关键词试试。</view></view><view wx:else class="empty">没有找到这个单元<navigator url="/pages/curriculum/index" class="primary-link">返回教材选择</navigator></view>
