<view wx:if="{{item}}" class="page"><view class="eyebrow">LISTEN &amp; NOTICE</view><view class="card center mint"><view class="title ipa">/{{item.symbol}}/</view><view class="subtitle">像 {{item.exampleWord}} 中的这个声音</view><audio-button ids="{{audioIds}}" label="听这个音"/></view><view class="section">常见拼写</view><view class="card"><view class="word-name">{{spellings}}</view><view class="muted">相同字母在不同单词里，也可能发出不同的音。</view></view><view class="section">比较一下</view><navigator wx:for="{{contrasts}}" wx:key="id" class="word-row" url="{{item.url}}"><view class="ipa">/{{item.symbol}}/</view><view>{{item.exampleWord}} →</view></navigator><view wx:if="{{words.length}}" class="section">在这些单词里找找它</view><navigator wx:for="{{words}}" wx:key="id" class="word-row" url="{{item.url}}">{{item.word}} →</navigator></view><view wx:else class="empty">没有找到这个声音</view>
