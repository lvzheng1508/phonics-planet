.brand{margin-bottom:28rpx}.brand-name{font-size:36rpx;font-weight:700;margin-top:8rpx}.circle-link{width:80rpx;height:80rpx;line-height:80rpx;border:2rpx solid #dce4da;border-radius:50%;text-align:center;font-size:44rpx}.hero-panel{position:relative;height:420rpx;overflow:hidden;border-radius:36rpx;background:#f7f6ef}.hero{width:100%;height:100%;opacity:.96}.hero-copy{position:absolute;left:24rpx;top:26rpx;max-width:60%}.hero-title{font-size:47rpx;font-weight:750;line-height:1.4;letter-spacing:-1rpx}.hero-note{font-size:26rpx;margin-top:18rpx;max-width:230rpx;line-height:1.6}.today-card{background:#193c3a;color:#fff;padding:32rpx;border-radius:32rpx;margin:20rpx 0 36rpx}.today-card .eyebrow{color:#b6dccc}.today-card .primary-link{background:#dff2d2;color:#193c3a}.stats{display:flex;justify-content:space-between;text-align:center;padding:26rpx 10rpx;color:#cee0da;font-size:25rpx}.number{font-size:48rpx;color:#fff;font-weight:700}.sun{font-size:52rpx;color:#f3cf70}.compact{margin:10rpx 0;font-size:34rpx}
.curriculum-link{display:flex;align-items:center;justify-content:space-between;min-height:88rpx;box-sizing:border-box;padding:20rpx 28rpx;margin:16rpx 0 24rpx;border:2rpx solid #187e77;border-radius:24rpx;background:#fff;color:#193c3a;font-size:30rpx;font-weight:600}
.global-search{display:flex;align-items:center;gap:24rpx;min-height:100rpx;background:#fff;border:2rpx solid #cddfd3;border-radius:24rpx;margin-bottom:24rpx;padding:20rpx 26rpx;color:#54716d;font-size:29rpx}.search-symbol{position:relative;width:28rpx;height:28rpx;border:3rpx solid #16776f;border-radius:50%;margin-right:4rpx}.search-symbol::after{content:"";position:absolute;width:14rpx;height:3rpx;background:#16776f;right:-11rpx;bottom:-6rpx;transform:rotate(45deg)}.search-entry-arrow{color:#16776f}
