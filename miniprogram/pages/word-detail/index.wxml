<view class="page" wx:if="{{item}}"><view class="eyebrow">ONE WORD, MANY SOUNDS</view><view class="title">{{item.word}}</view><view class="subtitle" wx:for="{{item.meanings}}" wx:key="*this">{{item}}</view><audio-button ids="{{audioIds}}" label="听整个单词"/><button class="secondary" bindtap="toggle">{{favorite ? '已收藏 · 点击取消' : '收藏这个单词'}}</button><view class="card" wx:if="{{ready}}"><view class="ipa">/{{item.ipa}}/</view><view class="section">一个音，一个音地读</view><navigator wx:for="{{sounds}}" url="/pages/phoneme-detail/index?id={{item.id}}">/{{item.symbol}}/ →</navigator><audio-button ids="{{sequence}}" label="依次听各个音"/><view class="section">拼读线索</view><view wx:for="{{item.segments}}">{{item.grapheme}} <text class="muted">{{item.note}}</text></view></view><view class="card muted" wx:else>这个单词的拼读讲解正在准备中。先把它收藏起来吧。</view></view><view wx:else class="empty">没有找到这个单词</view>
