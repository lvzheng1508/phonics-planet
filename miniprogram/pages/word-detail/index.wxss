.word-hero{text-align:center;padding:36rpx 8rpx 16rpx}.word-hero .title{font-size:68rpx;overflow-wrap:anywhere}.word-ipa{font-size:40rpx;margin:24rpx 0}.sound-grid{display:flex;gap:14rpx;flex-wrap:wrap;margin:24rpx 0}.sound-card{padding:20rpx 16rpx;background:white;border:3rpx solid #e2e8df;border-radius:24rpx;text-align:center;min-width:120rpx}.sound-card .ipa{font-size:44rpx}.sound-card.active{border-color:#16776f;background:#ddf0e9}.segment{display:flex;gap:28rpx;padding:22rpx 0;border-bottom:1rpx solid #edf0e9}.segment:last-child{border:0}.segment-letters{min-width:100rpx;font-size:42rpx;color:#16776f;font-weight:700}
