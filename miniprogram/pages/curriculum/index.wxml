<view class="page"><view class="eyebrow">LEARN WITH YOUR BOOK</view><view class="title">跟课本学</view><view class="subtitle">选一个单元，让课本里的单词发出声音。</view><view wx:for="{{books}}" wx:key="id" wx:for-item="book"><view class="section">{{book.name}}</view><button class="unit-card" wx:for="{{book.units}}" wx:key="id" data-book="{{book.id}}" data-unit="{{item.id}}" data-url="{{item.url}}" bindtap="choose"><view class="unit-number">{{item.number}}</view><view class="flex"><view class="card-title">{{item.name}}</view><view class="muted">{{item.entries.length}} 个词条 <text wx:if="{{selected === item.id}}">· 当前单元</text></view></view><text>→</text></button></view><view wx:if="{{!books.length}}" class="empty">教材正在准备中</view></view>
