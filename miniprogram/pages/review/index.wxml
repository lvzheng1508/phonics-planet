<view class="page"><view class="eyebrow">HELLO AGAIN</view><view class="title">和单词再见一面</view><view wx:if="{{current}}"><view class="row muted"><text>第 {{index + 1}} / {{total}} 张</text><text>自己回想，再翻开</text></view><view class="flash-card"><view class="word-name">{{current.word}}</view><view wx:if="{{current.hasIpa}}" class="phonetic-line {{playing ? 'is-playing' : ''}}"><text class="ipa-slash">/</text><text wx:for="{{ipaTokens}}" wx:key="key" class="ipa-token"><text>{{item.text}}</text><text aria-hidden="true" class="ipa-ink" style="{{item.style}}">{{item.text}}</text></text><text class="ipa-slash">/</text></view><view wx:if="{{current.pronunciationPending}}" class="preview-label">开发版音标 · 待教学核对</view><audio-button wx:if="{{audioIds.length}}" ids="{{audioIds}}" label="听一遍" owner="review-whole"/><view wx:if="{{current.audioSynthetic}}" class="preview-label">AI 合成试听 · 待发音核对 · 整词进度渐变</view><view wx:if="{{current.audioPreview}}" class="preview-label">系统合成试听 · 整词进度渐变</view><view wx:if="{{revealed}}" class="reveal"><view wx:for="{{current.meanings}}" wx:key="*this">{{item}}</view></view><button wx:else class="secondary" bindtap="reveal">想好了，翻开看看</button></view><view wx:if="{{revealed && !answered}}" class="grid"><button class="secondary" data-rating="again" bindtap="rate">还想再练练</button><button data-rating="known" bindtap="rate">我记住了</button></view><view wx:if="{{answered}}"><view class="card center">记录好了，下次复习：{{dueAt}}</view><button bindtap="next">{{index + 1 === total ? '完成这次复习' : '下一张 →'}}</button></view></view><view wx:elif="{{finished}}" class="empty"><view class="empty-star">✦</view><view class="section">又熟悉了一点！</view><view class="subtitle">这次复习了 {{reviewed}} 个词。</view><navigator url="/pages/today/index" class="primary-link">回到今日探索</navigator></view><view wx:else class="empty"><view class="empty-star">☆</view><view class="section">今天没有待复习的词</view><view class="subtitle">收藏新词后，它们会在这里等你。</view><navigator url="/pages/curriculum/index" class="primary-link">继续探索课本单词</navigator></view></view>
